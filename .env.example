# --- Основное ---
APP_ENV=dev
DATABASE_URL=sqlite:///./battlehall.db
# прод: postgresql+psycopg://user:pass@localhost:5432/battlehall

# --- Telegram ---
BOT_TOKEN=123456:REPLACE_ME
# Username бота без @ — из него собирается реферальная ссылка
BOT_USERNAME=battlehall_loyalty_bot
MINIAPP_URL=https://loyalty.example.com
CHANNEL_ID=@battlehall_channel

# --- Интеграция с OASys ---
# Токен вебхука клуба по умолчанию (slug "main") — seed.py заводит из него первый клуб.
# Токен должен состоять минимум из 32 символов (например, случайный токен token_urlsafe).
# У каждого следующего клуба сети свой токен, выдаётся при создании в панели.
OASYS_WEBHOOK_TOKEN=generate-random-secret-token-min-32-chars-long

# --- Админ-панель (http://localhost:8000/admin) ---
# Сервисный токен для программного доступа к /api/admin/* (скрипты, экспорт) — не менее 32 символов
ADMIN_TOKEN=generate-random-admin-token-min-32-chars-long
# Ключ подписи сессионной куки панели — не менее 32 символов
ADMIN_SESSION_SECRET=generate-random-session-secret-min-32-chars-long
ADMIN_SESSION_TTL_HOURS=12
# Логин/пароль первого администратора — заводится один раз в seed.py,
# смени пароль после первого входа (не менее 8 символов)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now-12345


# --- Google Sheets (необязательно) ---
# ID таблицы — часть ссылки между /d/ и /edit
GOOGLE_SHEET_ID=
# Путь к JSON-ключу сервисного аккаунта (файл НЕ коммитить)
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json
# Название листа внутри таблицы; если его нет — создастся с шапкой
GOOGLE_SHEET_WORKSHEET=Компенсации
# Писать строку сразу при подтверждении кода
GOOGLE_AUTOEXPORT=true

# --- Правила программы ---
# Игровой день начинается в 06:00 МСК
GAME_DAY_START_HOUR=6
# Срок жизни кода награды, часов
REWARD_CODE_TTL_HOURS=24
# Возвращать ли PTS, если код сгорел неиспользованным
REFUND_PTS_ON_EXPIRE=true
# Погашение просроченных кодов и возврат PTS — раз в 10 минут:
# */10 * * * * curl -fsS -X POST -H "X-Admin-Token: $ADMIN_TOKEN" https://<домен>/api/admin/maintenance/expire-codes

# Сколько PTS даём за ежедневный чек-ин
DAILY_CHECKIN_PTS=50
# Сколько минут должен отыграть приглашённый друг, чтобы засчитался реферал
REFERRAL_MIN_MINUTES=60

# --- OASys, живые данные из внутреннего API (необязательно) ---
# Пусто — раздел "Живая карта" в панели отдаёт понятную ошибку вместо данных.
# JWT/PC-JWT берутся из авторизованной сессии официального Windows-клиента
# админа зала (перехват своего же трафика через Fiddler — см. oASys_bot/oASys/*.har).
OASYS_BASE_URL=https://194.87.187.41
OASYS_API_HOST=api.oasystem.ru
OASYS_USER_AGENT=OasysAdmin/1.140.0.0
OASYS_JWT=
OASYS_PC_JWT=

# --- Dev ---
# Пускать в API без валидной подписи Telegram (ТОЛЬКО для локальной разработки)
DEV_ALLOW_FAKE_AUTH=true
DEV_FAKE_TELEGRAM_ID=100001

# --- Демо по публичной ссылке (туннель) ---
# Пусто — выключено. Задано — весь сайт закрыт этим паролем поверх обычной
# авторизации, пока показываем ссылку тем, кому доверяем.
DEMO_GATE_PASSWORD=
